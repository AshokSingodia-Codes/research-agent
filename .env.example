# LLM API Keys (Placeholders only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# System Authentication & Environment
ENV=development
API_KEY=your_api_key_here
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
CHECKPOINT_HMAC_KEY=your_optional_checkpoint_hmac_key_here

# LLM Model Configuration
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# Per-Agent LLM Models (fast/cheap for planner/researcher/supervisor, strong for writer/critic)
PLANNER_PROVIDER=groq
PLANNER_MODEL=llama-3.3-70b-versatile

RESEARCHER_PROVIDER=groq
RESEARCHER_MODEL=llama-3.3-70b-versatile

SUPERVISOR_PROVIDER=groq
SUPERVISOR_MODEL=llama-3.3-70b-versatile

WRITER_PROVIDER=groq
WRITER_MODEL=llama-3.3-70b-versatile

CRITIC_PROVIDER=groq
CRITIC_MODEL=llama-3.3-70b-versatile

# Redis Persistence Configuration
REDIS_URL=redis://localhost:6379/0
USE_FAKE_REDIS=true
REDIS_TTL_SECONDS=86400

# Hard Budget Limits
MAX_SUBQUESTIONS=5
MAX_SEARCHES_PER_SUBQUESTION=3
MAX_TOTAL_TOKENS=50000
MAX_USD_COST=1.00
WALL_CLOCK_TIMEOUT_SECONDS=240.0
MAX_REPAIR_ATTEMPTS=2
MAX_REVISION_LOOPS=1
CONCURRENCY_LIMIT=3
CITATION_COVERAGE_THRESHOLD=0.80

# Mock Overrides for Local Testing & CI
MOCK_SEARCH=auto
MOCK_LLM=auto
