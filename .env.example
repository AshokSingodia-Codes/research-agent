# LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# API Key for API Client Authentication
API_KEY=test-key-12345

# Per-Agent LLM Providers (anthropic, groq, fake)
PLANNER_PROVIDER=anthropic
PLANNER_MODEL=claude-haiku-5-5

RESEARCHER_PROVIDER=anthropic
RESEARCHER_MODEL=claude-haiku-5-5

WRITER_PROVIDER=anthropic
WRITER_MODEL=claude-sonnet-5-5

SUPERVISOR_PROVIDER=anthropic
SUPERVISOR_MODEL=claude-haiku-5-5

CRITIC_PROVIDER=anthropic
CRITIC_MODEL=claude-haiku-5-5

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
USE_FAKE_REDIS=true
REDIS_TTL_SECONDS=86400

# Budget Limits
MAX_SUBQUESTIONS=5
MAX_SEARCHES_PER_SUBQUESTION=3
MAX_TOTAL_TOKENS=50000
MAX_USD_COST=1.00
WALL_CLOCK_TIMEOUT_SECONDS=240.0
MAX_REPAIR_ATTEMPTS=2
MAX_REVISION_LOOPS=1
CONCURRENCY_LIMIT=3
CITATION_COVERAGE_THRESHOLD=0.80
